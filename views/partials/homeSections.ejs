<!-- partials/homeSections.ejs -->
<div class="home-wrapper">


  <!-- ══ HERO ══ -->
  <section class="hs-hero">
    <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-3" aria-hidden="true"></div>
    <div class="hero-grain" aria-hidden="true"></div>

    <div class="container hs-hero-inner">

      <div class="hero-university" data-aos="fade-down" data-aos-delay="50">
        <span class="university-name">Karnavati University</span>
      </div>

      <div class="hero-badge" data-aos="fade-down" data-aos-delay="100">
        <span class="badge-dot"></span>
        UIT &middot; Unitedworld Institute of Technology
      </div>

      <h1 class="hs-hero-title">
        <span class="title-line-sm" data-aos="fade-up" data-aos-delay="200">Welcome To</span>
        <span class="title-main" data-aos="fade-up" data-aos-delay="320">
          <span class="title-highlight">AAYAM</span>
        </span>
      </h1>

      <p class="hs-hero-tagline" data-aos="fade-up" data-aos-delay="560">
        आयाम &nbsp;&middot;&nbsp; Official UIT Students' Committee
      </p>

      <p class="hs-hero-sub" data-aos="fade-up" data-aos-delay="620">
        Where ideas become events, events become memories, and students become leaders.
      </p>

      <!-- ══════════════════════════════════════
           REGISTER NOW PROMO BANNER
      ══════════════════════════════════════ -->
      <% if (promo && promo.isActive) { %>
        <%
          var promoExpired = false;
          var promoMs = 0;
          if (promo.eventDate) {
            promoMs = new Date(promo.eventDate).getTime() - Date.now();
            if (promoMs <= 0) promoExpired = true;
          }
        %>
        <% if (!promoExpired) { %>
          <div class="hpb-wrapper" data-aos="fade-up" data-aos-delay="700" id="heroPromoBanner">

           <!-- Sub-heading -->
         <!-- Sub-heading -->
          <% if (promo.heading && promo.heading.trim() !== '') { %>
            <div class="hpb-sub-heading"><%= promo.heading %></div>
          <% } %>

          <!-- Event title with fire -->
          <div class="hpb-top-row">
            <span class="hpb-fire">🔥</span>
            <span class="hpb-register-heading"><%= promo.title %></span>
            <span class="hpb-fire">🔥</span>
          </div>

          <!-- Register Now -->
          <div class="hpb-event-title">REGISTER NOW</div>

            <% if (promo.description) { %>
              <div class="hpb-event-desc"><%= promo.description %></div>
            <% } %>

            <!-- Countdown -->
            <% if (promo.eventDate) { %>
              <div class="hpb-countdown-row" id="heroCountdown" data-target="<%= new Date(promo.eventDate).toISOString() %>">
                <div class="hpb-cd-block">
                  <span class="hpb-cd-num" id="hcd-days">00</span>
                  <span class="hpb-cd-label">DAYS</span>
                </div>
                <span class="hpb-cd-colon">:</span>
                <div class="hpb-cd-block">
                  <span class="hpb-cd-num" id="hcd-hours">00</span>
                  <span class="hpb-cd-label">HRS</span>
                </div>
                <span class="hpb-cd-colon">:</span>
                <div class="hpb-cd-block">
                  <span class="hpb-cd-num" id="hcd-mins">00</span>
                  <span class="hpb-cd-label">MIN</span>
                </div>
                <span class="hpb-cd-colon">:</span>
                <div class="hpb-cd-block">
                  <span class="hpb-cd-num" id="hcd-secs">00</span>
                  <span class="hpb-cd-label">SEC</span>
                </div>
              </div>
            <% } %>

            <!-- Register button -->
            <% if (promo.link && promo.link.trim() !== '') { %>
              <a href="<%= promo.link %>" target="_blank" rel="noopener noreferrer" class="hpb-cta-btn">
                Register Now &rarr;
              </a>
            <% } %>

          </div>
        <% } %>
      <% } %>
      <!-- ══ END PROMO BANNER ══ -->

      <div class="hero-cta-row" data-aos="fade-up" data-aos-delay="680">
        <a href="/events" class="hero-cta-primary">
          <span>Explore Events</span>
          <i class="bi bi-arrow-right-short"></i>
        </a>
        <a href="/team" class="hero-cta-secondary">Meet Our Team</a>
      </div>

      <div class="hero-stats" data-aos="fade-up" data-aos-delay="800">
        <div class="hero-stat">
          <span class="stat-number">50+</span>
          <span class="stat-label">Events Hosted</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-number">5+</span>
          <span class="stat-label">Active Clubs</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-number">1000+</span>
          <span class="stat-label">Students Impacted</span>
        </div>
      </div>

    </div>

    <div class="hero-scroll-hint" aria-hidden="true">
      <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
      <span>Scroll</span>
    </div>
  </section>


  <!-- ══ ADMIN PROMO MANAGER ══ -->
  <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
    <section class="hs-promo-admin" id="promoAdmin">
      <div class="container">
        <div class="promo-admin-card">
          <div class="promo-admin-header">
            <div class="promo-admin-icon">📣</div>
            <div>
              <div class="promo-admin-title">Register Now Banner</div>
              <div class="promo-admin-sub">Add a highlighted registration banner with countdown to the hero section</div>
            </div>
          </div>

          <!-- Existing promo -->
          <% if (promo) { %>
            <div class="promo-existing" style="margin-bottom:18px;">
              <div class="promo-existing-row">
                <div style="flex:1;">
                  <div style="font-weight:700;color:var(--tx);font-size:0.95rem;"><%= promo.title %></div>
                  <% if (promo.heading) { %><div style="font-size:0.82rem;color:var(--br);margin-top:2px;font-weight:600;"><%= promo.heading %></div><% } %>
                  <% if (promo.description) { %><div style="font-size:0.8rem;color:var(--tx-muted);margin-top:2px;"><%= promo.description %></div><% } %>
                  <% if (promo.eventDate) { %>
                    <div style="font-size:0.78rem;color:var(--br);margin-top:3px;font-weight:600;">
                      <i class="bi bi-calendar-event"></i>
                      Event Date: <%= new Date(promo.eventDate).toLocaleString('en-IN',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
                    </div>
                  <% } %>
                </div>
                <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;flex-wrap:wrap;">
                  <form action="/home/promo/<%= promo._id %>/toggle" method="POST" style="margin:0;">
                    <button type="submit" class="<%= promo.isActive ? 'btn-admin-warn' : 'btn-register' %>" style="font-size:0.75rem;padding:5px 12px;">
                      <%= promo.isActive ? '⏸ Hide Banner' : '▶ Show Banner' %>
                    </button>
                  </form>
                  <form action="/home/promo/<%= promo._id %>/delete" method="POST" style="margin:0;" onsubmit="return confirm('Delete this promo banner?')">
                    <button type="submit" class="btn-admin-danger" style="font-size:0.75rem;padding:5px 12px;">🗑 Delete</button>
                  </form>
                </div>
              </div>
              <div style="font-size:0.72rem;margin-top:6px;font-weight:700;color:<%= promo.isActive ? '#27ae60' : 'var(--tx-muted)' %>;">
                <%= promo.isActive ? '🟢 Banner is LIVE on home page' : '⭕ Banner is hidden' %>
              </div>
            </div>
          <% } %>

          <!-- Add / replace promo form -->
          <div class="promo-add-box">
            <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--br);margin-bottom:14px;">
              <i class="bi bi-plus-circle"></i> <%= promo ? 'Replace Banner' : 'Add New Banner' %>
            </div>
            <form action="/home/promo/add" method="POST">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">

                <div class="edit-field-group">
                  <label class="form-label-custom">Pill Label <span style="font-weight:400;color:var(--tx-muted);text-transform:none;font-size:0.72rem;">(e.g. "Register Now")</span></label>
                  <input type="text" name="label" class="form-control-custom" placeholder="Register Now" value="Register Now">
                </div>

                <div class="edit-field-group">
                  <label class="form-label-custom">Event Name <span style="color:#c0392b;">*</span></label>
                  <input type="text" name="title" class="form-control-custom" placeholder="e.g. AAYAM Fest 2026" required>
                </div>

                <div class="edit-field-group" style="grid-column:1/-1;">
                  <label class="form-label-custom">
                    Sub-Heading
                    <span style="font-weight:400;color:var(--tx-muted);text-transform:none;font-size:0.72rem;">(shown below "REGISTER NOW", above countdown — e.g. "Inter-college Technical Fest")</span>
                  </label>
                  <input type="text" name="heading" class="form-control-custom" placeholder="e.g. Inter-college Technical & Cultural Fest">
                </div>

                <div class="edit-field-group" style="grid-column:1/-1;">
                  <label class="form-label-custom">Short Description <span style="font-weight:400;color:var(--tx-muted);text-transform:none;font-size:0.72rem;">(optional — appears below event name)</span></label>
                  <input type="text" name="description" class="form-control-custom" placeholder="e.g. 3 days · 20+ events · Open to all colleges">
                </div>

                <div class="edit-field-group">
                  <label class="form-label-custom">Registration Link <span style="font-weight:400;color:var(--tx-muted);text-transform:none;font-size:0.72rem;">(optional)</span></label>
                  <input type="url" name="link" class="form-control-custom" placeholder="https://forms.google.com/...">
                </div>

                <div class="edit-field-group">
                  <label class="form-label-custom">
                    Event Date &amp; Time
                    <span style="font-weight:400;color:var(--tx-muted);text-transform:none;font-size:0.72rem;">(countdown target — auto-hides when reached)</span>
                  </label>
                  <input type="datetime-local" name="eventDate" class="form-control-custom">
                </div>

              </div>
              <button type="submit" class="btn-register" style="margin-top:4px;font-size:0.88rem;">
                <i class="bi bi-megaphone"></i> <%= promo ? 'Replace & Publish' : 'Publish Banner' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  <% } %>


  <!-- ══ INTRODUCTION ══ -->
  <section class="hs-intro">
    <div class="container">
      <div class="hs-intro-grid">
        <div class="intro-content-col">
          <div class="section-label" data-aos="fade-up">Who We Are</div>
          <h2 class="hs-section-title" data-aos="fade-up" data-aos-delay="80">
            AAYAM &ndash; UIT Students' Committee, Karnavati University <em class="title-em"></em>
          </h2>
          <p class="hs-slogan" data-aos="fade-up" data-aos-delay="140">Empowering Students. Enabling Events. Enhancing Campus Life.</p>
          <p class="hs-body-text" data-aos="fade-up" data-aos-delay="180">
            AAYAM is the heartbeat of student life at the Unitedworld Institute of Technology, Karnavati University &mdash; the official Students' Committee that drives every event, every celebration, and every opportunity that shapes the UIT experience. From intimate club meetings to grand inter-college festivals, we are the force that makes it all happen.
          </p>
          <p class="hs-body-text" data-aos="fade-up" data-aos-delay="220">
            We plan, organize, and execute with precision and passion. Whether it's a technical symposium, cultural fest, sports tournament, or industry collaboration &mdash; AAYAM brings together student talent, faculty support, and institutional resources to build futures, one experience at a time.
          </p>
          <div class="intro-pillars" data-aos="fade-up" data-aos-delay="280">
            <div class="pillar-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>Governance</div>
            <div class="pillar-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Collaboration</div>
            <div class="pillar-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>Innovation</div>
            <div class="pillar-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>Excellence</div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══ SCOPE CARDS ══ -->
  <section class="hs-scope">
    <div class="container">
      <div class="hs-section-header text-center">
        <div class="section-label" data-aos="fade-up">What We Do</div>
        <h2 class="hs-section-title" data-aos="fade-up" data-aos-delay="80">Our Operational Scope</h2>
        <p class="hs-section-desc" data-aos="fade-up" data-aos-delay="140">AAYAM is the central authority that plans, approves, and executes every student-led initiative at UIT &mdash; turning ideas into unforgettable experiences.</p>
      </div>
      <div class="scope-cards">
        <div class="scope-card" data-aos="fade-up" data-aos-delay="100">
          <div class="scope-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg></div>
          <h3 class="scope-card-title">Event Oversight</h3>
          <p class="scope-card-desc">From concept approval to post-event reporting &mdash; AAYAM oversees every phase of event management with structured quality assurance and meticulous planning.</p>
          <div class="scope-card-line"></div>
        </div>
        <div class="scope-card" data-aos="fade-up" data-aos-delay="180">
          <div class="scope-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v3"/><path d="M5.3 17.3 9 14"/><path d="M18.7 17.3 15 14"/><path d="M9 14h6"/></svg></div>
          <h3 class="scope-card-title">Departmental Bridge</h3>
          <p class="scope-card-desc">Acting as the connective tissue between all academic departments, clubs, and student bodies &mdash; enabling seamless inter-departmental collaboration and unified campus culture.</p>
          <div class="scope-card-line"></div>
        </div>
        <div class="scope-card" data-aos="fade-up" data-aos-delay="260">
          <div class="scope-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/><path d="M20 2v4h-4"/><path d="M16 2l4 4"/></svg></div>
          <h3 class="scope-card-title">Student Growth</h3>
          <p class="scope-card-desc">Creating platforms for students to lead, present, compete, and collaborate &mdash; nurturing the skills, confidence, and professional mindset needed for real-world success.</p>
          <div class="scope-card-line"></div>
        </div>
        <div class="scope-card" data-aos="fade-up" data-aos-delay="340">
          <div class="scope-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
          <h3 class="scope-card-title">Institutional Voice</h3>
          <p class="scope-card-desc">Representing the student community at the institutional level &mdash; advocating for student interests, ensuring transparent governance, and shaping policies that affect campus life.</p>
          <div class="scope-card-line"></div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══ ACTIVITIES GALLERY ══ -->
  <section class="hs-gallery">
    <div class="container">
      <div class="hs-section-header text-center">
        <div class="section-label" data-aos="fade-up">In Action</div>
        <h2 class="hs-section-title" data-aos="fade-up" data-aos-delay="80">Our Activities</h2>
        <p class="hs-section-desc" data-aos="fade-up" data-aos-delay="120">Every moment captured here is a testament to the energy, creativity, and spirit of the UIT student community.</p>
      </div>
      <% if (whatWeDoImages && whatWeDoImages.length) { %>
        <div class="hs-gallery-grid events-gallery">
          <% whatWeDoImages.forEach(function(img, i) { %>
            <div class="hs-gallery-item" data-aos="fade-up" data-aos-delay="<%= i * 70 %>">
              <div class="gallery-img-wrap">
                <img src="<%= img.image %>" loading="lazy" alt="AAYAM activity">
                <% if (user && (user.role === "admin" || user.role === "superadmin")) { %>
                  <form action="/home/delete/<%= img._id %>" method="POST" class="gallery-delete-form">
                    <button type="submit" class="gallery-delete-btn" title="Remove"><i class="bi bi-x-lg"></i></button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="gallery-empty" data-aos="fade-up">
          <div class="gallery-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.35"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
          <p>No activity images yet.</p>
        </div>
      <% } %>
      <% if (user && (user.role === "admin" || user.role === "superadmin")) { %>
        <div class="hs-upload-zone" data-aos="fade-up">
          <form action="/home/upload" method="POST" enctype="multipart/form-data" class="upload-form">
            <input type="hidden" name="section" value="what_we_do">
            <label class="upload-area" for="actFile" id="actLabel">
              <div class="upload-icon" id="actIcon">📁</div>
              <p class="upload-text" id="actText">Drop an activity image or <span class="upload-browse">browse</span></p>
              <input type="file" name="image" id="actFile" class="upload-input" accept="image/*" required onchange="handleFileSelect(this, 'actIcon', 'actText', 'actPreview')">
              <p class="upload-hint">PNG, JPG up to 10MB, only 4 photos can be added</p>
            </label>
            <div id="actPreview" class="upload-preview" style="display:none;">
              <img id="actPreviewImg" src="" alt="Preview" class="upload-preview-img">
              <span id="actPreviewName" class="upload-preview-name"></span>
              <button type="button" class="upload-preview-clear" onclick="clearFileSelect('actFile','actIcon','actText','actPreview')">✕ Clear</button>
            </div>
            <button type="submit" class="upload-submit-btn">Upload Activity Image</button>
          </form>
        </div>
      <% } %>
    </div>
  </section>


  <!-- ══ VISION & MISSION ══ -->
  <section class="hs-vision-mission">
    <div class="container">
      <div class="hs-section-header text-center">
        <div class="section-label" data-aos="fade-up">Our Compass</div>
        <h2 class="hs-section-title" data-aos="fade-up" data-aos-delay="80">Vision &amp; Mission</h2>
      </div>
      <div class="vm-grid">
        <div class="vm-panel vm-vision" data-aos="fade-right" data-aos-delay="100">
          <div class="vm-eyebrow">Our Direction</div>
          <div class="vm-icon-large"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg></div>
          <h3 class="vm-title">Strategic Vision</h3>
          <p class="vm-body">We envision UIT as a benchmark of student-led excellence &mdash; a thriving campus ecosystem where every event is a launchpad, every collaboration a milestone, and every student an architect of their own future. We strive to build an institution where ambition meets opportunity at every corner.</p>
          <div class="vm-tag-row"><span class="vm-tag">Leadership</span><span class="vm-tag">Innovation</span><span class="vm-tag">Inclusion</span></div>
        </div>
        <div class="vm-divider" aria-hidden="true">
          <div class="vm-divider-line"></div>
          <div class="vm-divider-diamond">◆</div>
          <div class="vm-divider-line"></div>
        </div>
        <div class="vm-panel vm-mission" data-aos="fade-left" data-aos-delay="200">
          <div class="vm-eyebrow">Our Purpose</div>
          <div class="vm-icon-large"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <h3 class="vm-title">Mission Objective</h3>
          <p class="vm-body">Our mission is to architect a structured, transparent, and inclusive framework that amplifies every student's voice. We are committed to organizing impactful events, fostering professional excellence, and building a campus culture where every student feels empowered to participate, lead, and grow beyond their limits.</p>
          <div class="vm-tag-row"><span class="vm-tag">Transparency</span><span class="vm-tag">Structure</span><span class="vm-tag">Excellence</span></div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══ EVENTS GALLERY ══ -->
  <section class="hs-events-section">
    <div class="container">
      <div class="hs-section-header text-center">
        <div class="section-label" data-aos="fade-up">Events &amp; Collaborations</div>
        <h2 class="hs-section-title" data-aos="fade-up" data-aos-delay="80">Moments That Matter</h2>
        <p class="hs-section-desc" data-aos="fade-up" data-aos-delay="140">From grand cultural fests to intimate technical workshops &mdash; AAYAM is the backbone behind every event that writes the story of UIT.</p>
        <div class="events-excellence-badge" data-aos="fade-up" data-aos-delay="200"><span class="badge-star">★</span> Powered by AAYAM Excellence <span class="badge-star">★</span></div>
      </div>
      <% if (eventImages && eventImages.length) { %>
        <div class="hs-gallery-grid events-gallery">
          <% eventImages.forEach(function(img, i) { %>
            <div class="hs-gallery-item" data-aos="fade-up" data-aos-delay="<%= i * 70 %>">
              <div class="gallery-img-wrap">
                <img src="<%= img.image %>" loading="lazy" alt="AAYAM event">
                <% if (user && (user.role === "admin" || user.role === "superadmin")) { %>
                  <form action="/home/delete/<%= img._id %>" method="POST" class="gallery-delete-form">
                    <button type="submit" class="gallery-delete-btn" title="Remove"><i class="bi bi-x-lg"></i></button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="gallery-empty" data-aos="fade-up">
          <div class="gallery-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.35"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
          <p>No event images yet.</p>
        </div>
      <% } %>
      <% if (user && (user.role === "admin" || user.role === "superadmin")) { %>
        <div class="hs-upload-zone" data-aos="fade-up">
          <form action="/home/upload" method="POST" enctype="multipart/form-data" class="upload-form">
            <input type="hidden" name="section" value="events">
            <label class="upload-area" for="evtFile" id="evtLabel">
              <div class="upload-icon" id="evtIcon">📁</div>
              <p class="upload-text" id="evtText">Drop an event image or <span class="upload-browse">browse</span></p>
              <input type="file" name="image" id="evtFile" class="upload-input" accept="image/*" required onchange="handleFileSelect(this, 'evtIcon', 'evtText', 'evtPreview')">
              <p class="upload-hint">PNG, JPG up to 10MB</p>
            </label>
            <div id="evtPreview" class="upload-preview" style="display:none;">
              <img id="evtPreviewImg" src="" alt="Preview" class="upload-preview-img">
              <span id="evtPreviewName" class="upload-preview-name"></span>
              <button type="button" class="upload-preview-clear" onclick="clearFileSelect('evtFile','evtIcon','evtText','evtPreview')">✕ Clear</button>
            </div>
            <button type="submit" class="upload-submit-btn">Upload Event Image</button>
          </form>
        </div>
      <% } %>
    </div>
  </section>


  <!-- ══ CONTACT ══ -->
