}
.promo-admin-icon {
  width: 40px; height: 40px; border-radius: var(--r-md);
  background: rgba(166,124,82,0.10);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem; flex-shrink: 0;
}
.promo-admin-title { font-weight: 700; font-size: 1rem; color: var(--tx); }
.promo-admin-sub   { font-size: 0.75rem; color: var(--tx-muted); margin-top: 2px; }
.promo-existing {
  background: rgba(166,124,82,0.05);
  border: 1.5px solid rgba(166,124,82,0.20);
  border-radius: var(--r-md);
  padding: 14px 16px;
}
.promo-existing-row { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
.promo-add-box {
  background: rgba(166,124,82,0.04);
  border: 1.5px dashed rgba(166,124,82,0.30);
  border-radius: var(--r-md);
  padding: 16px 18px;
