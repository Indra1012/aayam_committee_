<script>
/* ══════════════════════
   SLIDESHOW — arrows only, no auto on hover/tap
══════════════════════ */
var slideIndex  = 0;
var slideTimer  = null;
var slides      = document.querySelectorAll('.slide-item');
var dots        = document.querySelectorAll('.slide-dot');
var slideshowEl = document.querySelector('.slideshow-wrap');

function slideTo(n) {
  if (!slides.length) return;
  slides.forEach(function(s){ s.classList.remove('active'); });
  dots.forEach(function(d){ d.classList.remove('active'); });
  slideIndex = (n + slides.length) % slides.length;
  slides[slideIndex].classList.add('active');
  if (dots[slideIndex]) dots[slideIndex].classList.add('active');
}

function slideMove(dir) {
  slideTo(slideIndex + dir);
  resetAutoTimer(); // restart timer after manual arrow click
}

function startAutoTimer() {
  if (slides.length <= 1) return;
  slideTimer = setInterval(function(){ slideTo(slideIndex + 1); }, 2500);
}

function resetAutoTimer() {
  clearInterval(slideTimer);
  startAutoTimer();
}

function stopAutoTimer() {
  clearInterval(slideTimer);
}

// Only auto-advance when nothing is being interacted with
startAutoTimer();

// Pause auto when user hovers (desktop) or touches (mobile) the WRAPPER — NOT the image
if (slideshowEl) {
  slideshowEl.addEventListener('mouseenter', stopAutoTimer);
  slideshowEl.addEventListener('mouseleave', startAutoTimer);
  // Touch: arrows already call slideMove → resetAutoTimer
  // Prevent accidental swipe / tap on the image from changing slide
  slideshowEl.addEventListener('touchstart', function(e) {
    // only block if target is the image, not the buttons
    if (e.target.classList.contains('slide-img')) {
      e.preventDefault();
    }
  }, { passive: false });
}


/* ══════════════════════
   SCHEDULE MODAL
══════════════════════ */
function openSchedModal(id) {
  var overlay = document.getElementById('sched-modal-' + id);
  if (!overlay) return;
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeSchedModalById(id) {
  var overlay = document.getElementById('sched-modal-' + id);
  if (!overlay) return;
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}

function closeSchedModal(e, id) {
  // Only close if clicking the overlay itself, not the card
  if (e.target === document.getElementById('sched-modal-' + id)) {
    closeSchedModalById(id);
  }
}

// Close on Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    document.querySelectorAll('.sched-modal-overlay.open').forEach(function(el) {
      el.classList.remove('open');
    });
    document.body.style.overflow = '';
  }
});


/* ══════════════════════
   QUICK EDIT TOGGLE
══════════════════════ */
function toggleQuickEdit(subId) {
  var panel = document.getElementById('quick-edit-' + subId);
  if (!panel) return;
  var isOpen = panel.style.display !== 'none';
  panel.style.display = isOpen ? 'none' : 'block';
  if (!isOpen) {
    setTimeout(function() {
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 60);
  }
}


/* ══════════════════════
   GALLERY FILE NAMES
══════════════════════ */
function showGalleryFiles(input) {
  var el = document.getElementById('galleryFileNames');
  if (!el || !input.files.length) return;
  el.textContent = '✓ ' + input.files.length + ' file(s): ' + Array.from(input.files).map(function(f){ return f.name; }).join(', ');
  input.closest('.gup-file-area').style.borderColor = 'var(--br)';
}

function showSpeakerFiles(input) {
  var el = document.getElementById('speakerFileNames');
  if (!el || !input.files.length) return;
  el.textContent = '✓ ' + input.files.length + ' file(s): ' + Array.from(input.files).map(function(f){ return f.name; }).join(', ');
  input.closest('.gup-file-area').style.borderColor = 'var(--br)';
}
</script>

